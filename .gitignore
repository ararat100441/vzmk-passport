# Local validation results; retain all existing validation source scripts
**/validation/**
!**/validation/**/
!**/validation/**/*.py
!**/validation/**/*.ps1
!**/validation/**/*.cmd
!**/validation/**/*.mjs
!**/validation/**/*.js
# This accepted input preview is required by stage9_app/workspace.py
!/validation/stage6_fix_r1_r2_20261009_094707/current_preview.json
/validation/*CURRENT*.txt

# Local inventory and E2E execution reports
/audit/*.json
**/E2E_RESULT*.json
**/E2E_PREFLIGHT*.json
**/E2E_SAFETY_REPORT*.json

# Keep cache/dependency exclusions stronger than validation-source exceptions
node_modules*/
__pycache__/
.venv/
venv/
.codebase-index*/
backups/
*.py[cod]
