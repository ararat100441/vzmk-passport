# Build products (keep the existing PyInstaller .spec files)
build/
dist/
/stage9_build*/
/stage9_dist*/
*.exe
*.dll
*.pyd
*.msi

# Dependencies, editor state, indexes and operating-system files
node_modules*/
.codebase-index*/
